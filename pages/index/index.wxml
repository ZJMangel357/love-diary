<!--pages/index/index.wxml-->
<view class="page">
  <!-- ============ Hero 渐变区（粉橙渐变） ============ -->
  <view class="hero">
    <!-- 装饰元素 -->
    <view class="hero-deco-dot hero-deco-1"></view>
    <view class="hero-deco-dot hero-deco-2"></view>
    <view class="hero-deco-heart hero-deco-heart-1">💗</view>
    <view class="hero-deco-heart hero-deco-heart-2">✨</view>

    <!-- 状态栏占位 -->
    <view style="height: {{statusBarHeight}}px;"></view>

    <!-- 顶部标题栏：品牌 + 日期 -->
    <view class="hero-topbar">
      <view class="hero-brand">
        <text class="hero-brand-heart">❤</text>
        <text class="hero-brand-text">我们的恋爱空间</text>
      </view>
      <view class="hero-date">{{todayStr}}</view>
    </view>

    <!-- 在一起天数（视觉中心） -->
    <view class="hero-days-row animate-bounce-in">
      <text class="hero-days-label">在一起</text>
      <text class="hero-days-num">{{loveDays}}</text>
      <text class="hero-days-label">天</text>
    </view>

    <!-- 双头像 + 中间跳动爱心 -->
    <view class="hero-avatars" bindtap="onAvatarTap">
      <!-- 左侧头像（自己） -->
      <view class="hero-avatar-wrap">
        <view class="hero-avatar hero-avatar-left">
          <text class="hero-avatar-text">{{coupleInfo.avatarText1}}</text>
        </view>
      </view>

      <!-- 中间跳动爱心 -->
      <view class="hero-heart-pulse">
        <text class="hero-heart-emoji">💕</text>
      </view>

      <!-- 右侧头像：已配对显示真实头像，单人模式显示虚线占位框 -->
      <view class="hero-avatar-wrap" wx:if="{{coupleInfo.partnered}}">
        <view class="hero-avatar hero-avatar-right">
          <text class="hero-avatar-text">{{coupleInfo.avatarText2}}</text>
        </view>
      </view>
      <view class="hero-avatar-wrap" wx:else>
        <view class="hero-avatar-placeholder">
          <text class="hero-avatar-placeholder-text">+ TA</text>
        </view>
      </view>
    </view>

    <!-- 双方昵称 -->
    <view class="hero-names">
      <text class="hero-name hero-name-him">{{coupleInfo.partnerName1 || '我'}}</text>
      <text class="hero-name-and">&</text>
      <text class="hero-name hero-name-her" wx:if="{{coupleInfo.partnered}}">{{coupleInfo.partnerName2}}</text>
      <text class="hero-name hero-name-her hero-name-pending" wx:else>等你出现</text>
    </view>

    <!-- 下个纪念日倒计时胶囊 -->
    <view class="hero-countdown-pill" wx:if="{{nextAnniversary}}">
      <text class="hero-countdown-icon">🎀</text>
      <text class="hero-countdown-text">距{{nextAnniversary.title}}还有</text>
      <text class="hero-countdown-num">{{nextAnniversary.daysTo}}</text>
      <text class="hero-countdown-unit">天</text>
    </view>
  </view>

  <view class="main-content">
    <!-- ============ 单人模式提示条（条件显示） ============ -->
    <view class="single-tip" wx:if="{{singleMode}}">
      <text class="single-tip-emoji">💫</text>
      <text class="single-tip-text">单人体验中，分享配对码给 TA 即可开启双人模式</text>
    </view>

    <!-- ============ 恋爱打卡卡片 ============ -->
    <view class="checkin-card animate-slide-up" wx:if="{{checkin}}" bindtap="goToCheckin">
      <view class="cc-left">
        <view class="cc-heart {{checkin.myDone ? 'done' : ''}}">
          <text class="cc-heart-emoji">{{checkin.bothDone ? '💖' : checkin.myDone ? '💗' : '🤍'}}</text>
        </view>
      </view>
      <view class="cc-body">
        <view class="cc-row1">
          <text class="cc-title">恋爱打卡</text>
          <view class="cc-streak">
            <text class="cc-streak-num">{{checkin.streak}}</text>
            <text class="cc-streak-unit">天连签</text>
          </view>
        </view>
        <view class="cc-status">
          <text class="cc-status-text" wx:if="{{checkin.bothDone}}">🎉 今天一起打卡成功！</text>
          <text class="cc-status-text" wx:elif="{{checkin.myDone && !checkin.partnerDone}}">我已打卡，等 TA 一起点亮~</text>
          <text class="cc-status-text" wx:elif="{{!checkin.myDone && checkin.partnerDone}}">TA 已打卡，快跟上！</text>
          <text class="cc-status-text" wx:else>今天还没打卡，快去点亮爱心~</text>
        </view>
        <view class="cc-partner">
          <text class="cc-p-item {{checkin.myDone ? 'ok' : ''}}">我 {{checkin.myDone ? '✓' : '○'}}</text>
          <text class="cc-p-item {{checkin.partnerDone ? 'ok' : ''}}">TA {{checkin.partnerDone ? '✓' : '○'}}</text>
        </view>
      </view>
      <view class="cc-arrow">›</view>
    </view>

    <!-- ============ 每日情话卡片（可换一句） ============ -->
    <view class="quote-card animate-slide-up" bindtap="changeQuote">
      <view class="quote-icon">💌</view>
      <view class="quote-body">
        <text class="quote-text">{{loveQuote}}</text>
      </view>
      <view class="quote-refresh">
        <text class="quote-refresh-icon">🔄</text>
        <text class="quote-refresh-text">换一句</text>
      </view>
    </view>

    <!-- ============ 快捷入口（宫格） ============ -->
    <view class="quick-grid">
      <view class="quick-item animate-slide-up" wx:for="{{quickActions}}" wx:key="id"
            style="animation-delay: {{index * 0.06}}s;"
            data-page="{{item.page}}" bindtap="goToPage">
        <view class="quick-icon quick-{{item.color}}">{{item.icon}}</view>
        <view class="quick-title">{{item.title}}</view>
        <view class="quick-desc">{{item.desc}}</view>
      </view>
    </view>

    <!-- ============ 今天吃什么卡片 ============ -->
    <view class="section-title" bindtap="goToMenuDetail">
      🍽️ 今天吃什么
      <text class="section-more">查看全部 ›</text>
    </view>
    <view class="today-menu-card animate-slide-up" wx:if="{{todayMenu}}" bindtap="goToMenuDetail">
      <image wx:if="{{todayMenu.image}}" class="menu-dish-img" src="{{todayMenu.image}}" mode="aspectFill" />
      <view class="menu-dish-emoji" wx:else>🍳</view>
      <view class="menu-dish-info">
        <view class="dish-name-row">
          <text class="dish-name">{{todayMenu.name}}</text>
          <view class="dish-fav" wx:if="{{todayMenu.favorite}}">💖</view>
        </view>
        <view class="dish-tags">
          <text class="tag tag-pink" wx:if="{{todayMenu.category}}">{{todayMenu.category}}</text>
          <text class="tag tag-mint" wx:for="{{todayMenu.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
        <view class="dish-meta">
          <text>难度: {{todayMenu.difficulty === 1 ? '⭐' : todayMenu.difficulty === 2 ? '⭐⭐' : '⭐⭐⭐'}}</text>
          <text class="creator">👨‍🍳 {{todayMenu.creator || '爱心出品'}}</text>
        </view>
      </view>
      <view class="menu-random-btn" catchtap="randomMenu">
        <text class="dice-emoji">🎲</text>
        <text class="random-text">换一个</text>
      </view>
    </view>
    <view class="empty-card" wx:else>
      <text class="empty-emoji">🥗</text>
      <text class="empty-text">还没有菜品，去添加吧~</text>
    </view>

    <!-- ============ 即将到来的纪念日列表 ============ -->
    <view class="section-title" bindtap="goToAnniversary">
      📅 即将到来
      <text class="section-more">全部纪念日 ›</text>
    </view>
    <view class="anniv-list" wx:if="{{nearestAnniversaries.length > 0}}">
      <view class="anniv-item animate-slide-up" wx:for="{{nearestAnniversaries}}" wx:key="id"
            style="animation-delay: {{index * 0.1}}s;"
            bindtap="goToAnniversary">
        <view class="anniv-emoji {{item.important ? 'important' : ''}}">{{item.emoji || '💝'}}</view>
        <view class="anniv-info">
          <view class="anniv-title">{{item.title}}</view>
          <view class="anniv-date">{{item.displayDate}}</view>
        </view>
        <view class="anniv-countdown {{item.daysTo <= 7 ? 'urgent' : ''}}">
          <text class="countdown-num">{{item.daysTo}}</text>
          <text class="countdown-label">天</text>
        </view>
      </view>
    </view>
    <view class="empty-card" wx:else>
      <text class="empty-emoji">🎈</text>
      <text class="empty-text">暂无纪念日，快去添加你们的重要日子~</text>
    </view>

    <!-- ============ 最近时光横向滚动卡片 ============ -->
    <view class="section-title" bindtap="goToMoments">
      💝 我们的时光
      <text class="section-more">更多回忆 ›</text>
    </view>
    <scroll-view scroll-x="true" class="moments-scroll" wx:if="{{recentMoments.length > 0}}">
      <view class="moment-card animate-slide-up" wx:for="{{recentMoments}}" wx:key="id"
            bindtap="goToMoments">
        <image wx:if="{{item.coverImage}}" class="moment-cover" src="{{item.coverImage}}" mode="aspectFill" />
        <view class="moment-mood" wx:else>{{item.mood || '💕'}}</view>
        <view class="moment-title">{{item.title}}</view>
        <view class="moment-content">{{item.content}}</view>
        <view class="moment-footer">
          <text class="moment-date">{{item.date}}</text>
          <text class="moment-location" wx:if="{{item.location}}">📍{{item.location}}</text>
        </view>
      </view>
      <view class="moment-card add-card" bindtap="goToPage" data-page="/pages/moments-add/moments-add">
        <text class="add-plus">+</text>
        <text class="add-text">记录<br/>新时光</text>
      </view>
    </scroll-view>
    <view class="empty-card" wx:else bindtap="goToPage" data-page="/pages/moments-add/moments-add">
      <text class="empty-emoji">📷</text>
      <text class="empty-text">还没有记录，点击添加第一个美好瞬间吧~</text>
    </view>

    <!-- ============ 经期状态卡片 ============ -->
    <view class="section-title" bindtap="goToPeriod">
      🌸 身体小助手
      <text class="section-more">详情 ›</text>
    </view>
    <view class="period-card animate-slide-up" wx:if="{{periodInfo}}" bindtap="goToPeriod">
      <view class="period-phase" style="background: {{periodInfo.bgColor}};">
        <text class="phase-text" style="color: {{periodInfo.color}};">{{periodInfo.phaseName}}</text>
      </view>
      <view class="period-info-content">
        <text class="period-desc">{{periodInfo.description}}</text>
        <view class="progress-bar mt-16">
          <view class="progress-fill" style="width: {{periodInfo.progress}}%;"></view>
        </view>
        <view class="period-next-event">{{periodInfo.nextEvent}}</view>
      </view>
      <view class="period-next-days">
        <text class="next-num">{{periodInfo.daysToNext}}</text>
        <text class="next-label">天后<br/>下次</text>
      </view>
    </view>
    <view class="period-record-card animate-slide-up" wx:else bindtap="goToPeriod">
      <view class="pr-icon">🌸</view>
      <view class="pr-info">
        <text class="pr-title">还没有记录经期</text>
        <text class="pr-desc">点击记录，预测下次经期时间</text>
      </view>
      <text class="pr-arrow">›</text>
    </view>

    <view style="height: 120rpx;"></view>
  </view>
</view>
