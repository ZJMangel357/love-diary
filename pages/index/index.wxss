/* pages/index/index.wxss - 情侣日记首页（甜暖私密风） */

/* ============ 页面容器 ============ */
.page {
  min-height: 100vh;
  background: #FFF5F8;
}

/* ============ Hero 渐变区（粉橙渐变） ============ */
.hero {
  position: relative;
  background: linear-gradient(135deg, #EC4899 0%, #FB923C 100%);
  padding: 0 32rpx 56rpx;
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

/* Hero 装饰：渐变光斑 */
.hero-deco-dot {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  opacity: 0.18;
}

.hero-deco-1 {
  top: -60rpx;
  right: -50rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, #FFFFFF 0%, transparent 70%);
}

.hero-deco-2 {
  bottom: 40rpx;
  left: -60rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, #FED7AA 0%, transparent 70%);
  opacity: 0.35;
}

/* Hero 装饰：漂浮爱心 */
.hero-deco-heart {
  position: absolute;
  pointer-events: none;
  opacity: 0.5;
  animation: float 3.5s ease-in-out infinite;
}

.hero-deco-heart-1 {
  top: 110rpx;
  left: 44rpx;
  font-size: 56rpx;
}

.hero-deco-heart-2 {
  top: 180rpx;
  right: 70rpx;
  font-size: 40rpx;
  animation-delay: 1.2s;
  opacity: 0.7;
}

/* ============ 顶部标题栏 ============ */
.hero-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 8rpx 12rpx;
  position: relative;
  z-index: 2;
}

.hero-brand {
  display: flex;
  align-items: center;
}

.hero-brand-heart {
  font-size: 32rpx;
  margin-right: 12rpx;
  animation: heart-beat 1.6s ease-in-out infinite;
}

.hero-brand-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.hero-date {
  font-size: 24rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.22);
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  backdrop-filter: blur(10px);
}

/* ============ 在一起天数（视觉中心） ============ */
.hero-days-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-top: 24rpx;
  position: relative;
  z-index: 2;
}

.hero-days-label {
  font-size: 30rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: 2rpx;
}

.hero-days-num {
  font-size: 120rpx;
  font-weight: 900;
  color: #FFFFFF;
  line-height: 1;
  margin: 0 12rpx;
  text-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.18);
  letter-spacing: -2rpx;
}

/* ============ 双头像 + 中间跳动爱心 ============ */
.hero-avatars {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  position: relative;
  z-index: 2;
}

.hero-avatar-wrap {
  position: relative;
}

.hero-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(8px);
  border: 4rpx solid #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.14);
}

.hero-avatar-left {
  background: linear-gradient(135deg, #FCE7F3 0%, #FFFFFF 100%);
}

.hero-avatar-right {
  background: linear-gradient(135deg, #FED7AA 0%, #FFFFFF 100%);
}

.hero-avatar-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #EC4899;
}

/* 单人模式虚线占位框 */
.hero-avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx dashed rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-avatar-placeholder-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* 中间跳动爱心 */
.hero-heart-pulse {
  margin: 0 20rpx;
  animation: heart-beat 1.4s ease-in-out infinite;
}

.hero-heart-emoji {
  font-size: 48rpx;
  filter: drop-shadow(0 4rpx 12rpx rgba(0, 0, 0, 0.2));
}

/* ============ 双方昵称 ============ */
.hero-names {
  text-align: center;
  margin-top: 20rpx;
  position: relative;
  z-index: 2;
}

.hero-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.hero-name-him {
  color: #FFFFFF;
}

.hero-name-her {
  color: #FFF5F8;
}

.hero-name-pending {
  opacity: 0.8;
  font-style: italic;
}

.hero-name-and {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin: 0 14rpx;
}

/* ============ 下个纪念日倒计时胶囊 ============ */
.hero-countdown-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx auto 0;
  padding: 12rpx 28rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(12px);
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  width: fit-content;
  position: relative;
  z-index: 2;
}

.hero-countdown-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.hero-countdown-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.hero-countdown-num {
  font-size: 32rpx;
  font-weight: 900;
  color: #FFFFFF;
  margin: 0 6rpx;
}

.hero-countdown-unit {
  font-size: 24rpx;
  color: #FFFFFF;
}

/* ============ 主内容区 ============ */
.main-content {
  padding: 32rpx 32rpx 48rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 10;
}

/* ============ 单人模式提示条 ============ */
.single-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 18rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(236, 72, 153, 0.1);
  border: 2rpx solid #FCE7F3;
}

.single-tip-emoji {
  font-size: 28rpx;
  flex-shrink: 0;
}

.single-tip-text {
  font-size: 24rpx;
  color: #6B7280;
  flex: 1;
  line-height: 1.5;
}

/* ============ 每日情话卡片 ============ */
.quote-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFF1F6 0%, #FFF8F0 60%, #FFFCEF 100%);
  border-radius: 32rpx;
  padding: 28rpx 28rpx;
  box-shadow: 0 10rpx 32rpx rgba(236, 72, 153, 0.12);
  margin-bottom: 32rpx;
  position: relative;
  overflow: hidden;
}

.quote-card::after {
  content: '✨';
  position: absolute;
  right: 16rpx;
  top: -12rpx;
  font-size: 56rpx;
  opacity: 0.18;
}

.quote-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.quote-body {
  flex: 1;
  min-width: 0;
}

.quote-text {
  font-size: 28rpx;
  color: #1F2937;
  line-height: 1.6;
  font-weight: 500;
}

.quote-refresh {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 12rpx 16rpx;
  background: rgba(236, 72, 153, 0.12);
  border-radius: 20rpx;
}

.quote-refresh-icon {
  font-size: 28rpx;
}

.quote-refresh-text {
  font-size: 20rpx;
  color: #EC4899;
  font-weight: 600;
  margin-top: 2rpx;
}

/* ============ 区块标题 ============ */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  margin: 36rpx 0 20rpx;
  display: flex;
  align-items: center;
}

.section-more {
  margin-left: auto;
  font-size: 24rpx;
  color: #EC4899;
  font-weight: 500;
}

/* ============ 4大快捷入口（宫格） ============ */
.quick-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -12rpx;
}

.quick-item {
  width: calc(50% - 24rpx);
  margin: 0 12rpx 24rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(236, 72, 153, 0.1);
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.quick-item:active {
  transform: scale(0.96);
}

.quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 16rpx;
}

/* 浅色背景：粉 / 紫 / 黄 / 绿 */
.quick-pink { background: linear-gradient(135deg, #FCE7F3 0%, #FBCFE8 100%); }
.quick-purple { background: linear-gradient(135deg, #EDE9FE 0%, #DDD6FE 100%); }
.quick-yellow { background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%); }
.quick-mint { background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%); }

.quick-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 6rpx;
}

.quick-desc {
  font-size: 22rpx;
  color: #6B7280;
}

/* ============ 今天吃什么卡片 ============ */
.today-menu-card {
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 12rpx 36rpx rgba(236, 72, 153, 0.12);
  position: relative;
  overflow: hidden;
}

.today-menu-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 12rpx;
  background: linear-gradient(180deg, #EC4899 0%, #FB923C 100%);
}

.menu-dish-emoji {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #FFF1F6 0%, #FFFCEF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-dish-info {
  flex: 1;
  min-width: 0;
}

.dish-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.dish-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #1F2937;
}

.dish-fav {
  font-size: 28rpx;
  margin-left: 10rpx;
}

.dish-tags {
  margin-bottom: 12rpx;
}

.dish-meta {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #6B7280;
}

.creator {
  margin-left: auto;
  font-weight: 600;
  color: #EC4899;
}

.menu-random-btn {
  margin-left: 16rpx;
  padding: 16rpx;
  background: linear-gradient(135deg, #FCE7F3 0%, #FEF3C7 100%);
  border-radius: 24rpx;
  text-align: center;
  flex-shrink: 0;
}

.dice-emoji {
  font-size: 36rpx;
  display: block;
}

.random-text {
  font-size: 20rpx;
  color: #EC4899;
  font-weight: 600;
}

/* ============ 空状态卡片 ============ */
.empty-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.empty-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #6B7280;
}

/* ============ 即将到来的纪念日列表 ============ */
.anniv-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.anniv-item {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(236, 72, 153, 0.08);
  position: relative;
  overflow: hidden;
}

.anniv-emoji {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFF1F6 0%, #FFFCEF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.anniv-emoji.important {
  background: linear-gradient(135deg, #FCE7F3 0%, #FEF3C7 100%);
  box-shadow: 0 0 0 4rpx rgba(251, 146, 60, 0.3);
}

.anniv-info {
  flex: 1;
  min-width: 0;
}

.anniv-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 6rpx;
}

.anniv-date {
  font-size: 24rpx;
  color: #6B7280;
}

.anniv-countdown {
  text-align: center;
  padding: 12rpx 20rpx;
  background: linear-gradient(135deg, rgba(236, 72, 153, 0.12) 0%, rgba(251, 146, 60, 0.12) 100%);
  border-radius: 20rpx;
  flex-shrink: 0;
}

.anniv-countdown.urgent {
  background: linear-gradient(135deg, rgba(236, 72, 153, 0.28) 0%, rgba(251, 146, 60, 0.28) 100%);
}

.countdown-num {
  font-size: 40rpx;
  font-weight: 900;
  color: #EC4899;
  display: block;
  line-height: 1;
}

.countdown-label {
  font-size: 20rpx;
  color: #6B7280;
}

/* ============ 最近时光横向滚动卡片 ============ */
.moments-scroll {
  white-space: nowrap;
  padding: 8rpx 0 16rpx;
  margin: 0 -32rpx;
  padding-left: 32rpx;
}

.moment-card {
  display: inline-block;
  width: 400rpx;
  vertical-align: top;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 24rpx;
  margin-right: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(236, 72, 153, 0.14);
  white-space: normal;
}

.moment-mood {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}

.moment-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.moment-content {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.moment-footer {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #9CA3AF;
}

.moment-location {
  margin-left: auto;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.moment-card.add-card {
  background: linear-gradient(135deg, #FFF1F6 0%, #FEF3C7 100%);
  border: 3rpx dashed #FB923C;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 240rpx;
  box-sizing: border-box;
}

.add-plus {
  font-size: 72rpx;
  color: #FB923C;
  font-weight: 300;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #EC4899;
  font-weight: 600;
  text-align: center;
  margin-top: 8rpx;
}

/* ============ 经期状态卡片 ============ */
.period-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 32rpx rgba(139, 92, 246, 0.12);
}

.period-phase {
  padding: 14rpx 20rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.phase-text {
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

.period-info-content {
  flex: 1;
  min-width: 0;
}

.period-desc {
  font-size: 26rpx;
  color: #1F2937;
}

.period-next-event {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 10rpx;
}

.period-next-days {
  text-align: center;
  margin-left: 16rpx;
  padding-left: 16rpx;
  border-left: 2rpx dashed #FCE7F3;
  flex-shrink: 0;
}

.next-num {
  font-size: 44rpx;
  font-weight: 900;
  color: #8B5CF6;
  display: block;
  line-height: 1;
}

.next-label {
  font-size: 18rpx;
  color: #6B7280;
  line-height: 1.2;
}

.period-record-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 32rpx rgba(236, 72, 153, 0.1);
}

.pr-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.pr-info {
  flex: 1;
}

.pr-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  display: block;
  margin-bottom: 6rpx;
}

.pr-desc {
  font-size: 24rpx;
  color: #6B7280;
}

.pr-arrow {
  font-size: 40rpx;
  color: #9CA3AF;
}

/* ============ 爱心跳动动画（scale 1 → 1.2 → 1） ============ */
@keyframes heart-beat {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}
