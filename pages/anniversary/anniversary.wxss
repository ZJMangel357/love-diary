/* pages/anniversary/anniversary.wxss */
.page {
  min-height: 100vh;
  background: #F9F6FF;
}

.hero-section {
  padding: 40rpx 32rpx 48rpx;
}

.stats-row {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255,255,255,0.95);
  border-radius: 28rpx;
  padding: 20rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
}

.stat-num {
  font-size: 48rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #9B7FED 0%, #FF6B9D 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: block;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #8A7F8A;
  margin-top: 4rpx;
}

.container {
  padding-top: 24rpx;
}

.filter-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  margin-right: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.3s ease;
}

.filter-chip.active {
  background: linear-gradient(135deg, #9B7FED 0%, #C9B1FF 100%);
  box-shadow: 0 6rpx 20rpx rgba(155,127,237,0.35);
}

.filter-chip.active .chip-label {
  color: #FFFFFF;
}

.chip-emoji {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.chip-label {
  font-size: 26rpx;
  color: #8A7F8A;
  font-weight: 500;
}

.anniv-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.anniv-card {
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 28rpx;
  display: flex;
  align-items: stretch;
  box-shadow: 0 10rpx 32rpx rgba(155,127,237,0.1);
  position: relative;
  overflow: hidden;
}

.anniv-card.important-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF8E8 100%);
  box-shadow: 0 12rpx 36rpx rgba(255,179,71,0.15);
  border: 2rpx solid rgba(255,217,61,0.3);
}

.anniv-count {
  width: 140rpx;
  flex-shrink: 0;
  text-align: center;
  padding: 16rpx 0;
  background: linear-gradient(135deg, rgba(201,177,255,0.2) 0%, rgba(255,180,204,0.2) 100%);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.anniv-count.urgent {
  background: linear-gradient(135deg, rgba(255,107,157,0.3) 0%, rgba(255,217,61,0.3) 100%);
}

.anniv-count.passed {
  background: rgba(168,230,207,0.25);
}

.count-days {
  font-size: 40rpx;
  font-weight: 900;
  color: #9B7FED;
  display: block;
  line-height: 1;
  word-break: break-all;
}

.anniv-count.urgent .count-days {
  color: #FF6B9D;
  animation: pulse 1.2s ease-in-out infinite;
}

.anniv-count.passed .count-days {
  color: #5CC9A5;
}

.count-label {
  font-size: 20rpx;
  color: #8A7F8A;
  margin-top: 6rpx;
}

.anniv-sep {
  width: 2rpx;
  background: linear-gradient(180deg, transparent, #F0E6E6, transparent);
  margin: 0 24rpx;
}

.anniv-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.anniv-head {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.anniv-emoji-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #F9F6FF 0%, #FFF5F8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.anniv-title-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.anniv-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #4A4A4A;
}

.important-badge {
  font-size: 20rpx;
  color: #CC7A3D;
  background: rgba(255,217,61,0.3);
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 700;
}

.anniv-date-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.anniv-date {
  font-size: 26rpx;
  color: #8A7F8A;
}

.anniv-repeat {
  font-size: 22rpx;
  color: #9B7FED;
  background: rgba(155,127,237,0.1);
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
}

.anniv-years {
  font-size: 22rpx;
  color: #FF6B9D;
  background: rgba(255,107,157,0.1);
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  font-weight: 700;
}

.anniv-since {
  font-size: 22rpx;
  color: #B8A5A5;
  margin-bottom: 12rpx;
}

.anniv-progress {
  margin-top: auto;
}

.progress-bar {
  height: 12rpx;
}
