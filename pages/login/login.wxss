/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF5F8 0%, #F0FFF9 50%, #FFFEF0 100%);
  position: relative;
  overflow: hidden;
  padding: 0 48rpx;
  box-sizing: border-box;
}

/* 装饰背景 */
.deco-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(40rpx);
  pointer-events: none;
}

.blob-pink {
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 107, 157, 0.15);
  top: -100rpx;
  right: -100rpx;
}

.blob-mint {
  width: 300rpx;
  height: 300rpx;
  background: rgba(168, 230, 207, 0.2);
  bottom: 100rpx;
  left: -80rpx;
}

.blob-yellow {
  width: 250rpx;
  height: 250rpx;
  background: rgba(255, 217, 61, 0.12);
  top: 40%;
  right: -60rpx;
}

/* 浮动爱心 */
.floating-heart {
  position: absolute;
  pointer-events: none;
  animation: floatUp 6s ease-in-out infinite;
}

.fh1 { top: 15%; left: 10%; font-size: 48rpx; opacity: 0.2; }
.fh2 { top: 30%; right: 15%; font-size: 36rpx; opacity: 0.15; animation-delay: 1.5s; }
.fh3 { top: 60%; left: 20%; font-size: 40rpx; opacity: 0.18; animation-delay: 3s; }

@keyframes floatUp {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-30rpx) rotate(10deg); }
}

/* 主内容区 */
.login-main {
  position: relative;
  z-index: 1;
  padding-top: 80rpx;
}

/* Logo 区域 */
.logo-wrap {
  text-align: center;
  margin-bottom: 64rpx;
}

.logo-emoji {
  font-size: 120rpx;
  margin-bottom: 16rpx;
  animation: pulse 2s ease-in-out infinite;
}

.logo-title {
  font-size: 56rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B9D 0%, #C9B1FF 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8rpx;
}

.logo-subtitle {
  font-size: 28rpx;
  color: #B8A5A5;
}

/* 表单卡片 */
.form-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 36rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(255, 107, 157, 0.12);
  backdrop-filter: blur(20px);
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A4A4A;
  margin-bottom: 16rpx;
  margin-top: 24rpx;
}

.form-label:first-child {
  margin-top: 0;
}

.form-input-wrap {
  display: flex;
  align-items: center;
  background: #FFF5F8;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 8rpx;
}

.form-input {
  flex: 1;
  height: 80rpx;
  font-size: 32rpx;
  color: #4A4A4A;
}

.form-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFB4CC 0%, #C9B1FF 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.form-date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F5FFF9;
  border-radius: 24rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #4A4A4A;
  margin-bottom: 32rpx;
}

.form-date-picker .arrow {
  color: #B8A5A5;
  font-size: 36rpx;
}

/* 邀请提示 */
.invite-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  gap: 12rpx;
}

.hint-emoji {
  font-size: 40rpx;
}

.hint-text {
  font-size: 28rpx;
  color: #FF6B9D;
  font-weight: 500;
}

/* 配对码卡片 */
.pairing-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 36rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(255, 107, 157, 0.12);
  text-align: center;
  backdrop-filter: blur(20px);
}

.pairing-code-label {
  font-size: 28rpx;
  color: #8A7F8A;
  margin-bottom: 16rpx;
}

.pairing-code {
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: 12rpx;
  background: linear-gradient(135deg, #FF6B9D 0%, #FFD93D 50%, #C9B1FF 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 16rpx;
}

.pairing-code-hint {
  font-size: 24rpx;
  color: #B8A5A5;
  margin-bottom: 32rpx;
}

/* 分享按钮 */
.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.share-icon {
  font-size: 32rpx;
}

.copy-btn {
  font-size: 26rpx;
  color: #8A7F8A;
  padding: 16rpx;
}

.copy-btn:active {
  opacity: 0.6;
}

/* 等待动画 */
.waiting-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 48rpx;
}

.pulse-dots {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF6B9D;
  animation: dotPulse 1.4s ease-in-out infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotPulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1.2); }
}

.waiting-text {
  font-size: 26rpx;
  color: #B8A5A5;
}

/* 成功页面 */
.success-wrap {
  text-align: center;
  padding-top: 80rpx;
}

.success-emoji {
  font-size: 120rpx;
  margin-bottom: 16rpx;
  animation: bounce-in 0.8s ease-out;
}

.success-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #FF6B9D;
  margin-bottom: 48rpx;
}

.couple-show {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 24rpx;
}

.cs-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 600;
  color: #FFFFFF;
  border: 6rpx solid #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.2);
}

.cs-left {
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB4CC 100%);
}

.cs-right {
  background: linear-gradient(135deg, #C9B1FF 0%, #FFB4CC 100%);
}

.cs-heart {
  font-size: 56rpx;
}

.couple-names-show {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A4A4A;
  margin-bottom: 12rpx;
}

.success-desc {
  font-size: 28rpx;
  color: #8A7F8A;
}
