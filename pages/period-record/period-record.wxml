<!--pages/period-record/period-record.wxml-->
<view class="page">
  <!-- 新增记录卡片 -->
  <view class="add-card">
    <view class="ac-title">🌸 记录经期开始</view>

    <view class="ac-row">
      <text class="ac-label">起始日期</text>
      <picker mode="date" value="{{startDate}}" end="{{todayStr}}" bindchange="changeDate">
        <view class="ac-date">{{startDate}} ›</view>
      </picker>
    </view>

    <view class="ac-row col">
      <text class="ac-label">身体状况（可多选）</text>
      <view class="symp-grid">
        <view class="symp-item {{selectedSymptoms.includes(item.key) ? 'active' : ''}}"
              wx:for="{{commonSymptoms}}" wx:key="key"
              data-key="{{item.key}}" bindtap="toggleSymptom">
          <text class="si-emoji">{{item.emoji}}</text>
          <text class="si-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="ac-row col">
      <text class="ac-label">经量</text>
      <view class="flow-row">
        <view class="flow-item {{flowLevel === item.level ? 'active' : ''}}"
              wx:for="{{flowLevels}}" wx:key="level"
              data-level="{{item.level}}" bindtap="changeFlow">
          <text class="fi-emoji">{{item.emoji}}</text>
          <text class="fi-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="ac-row col">
      <text class="ac-label">备注（选填）</text>
      <textarea class="form-textarea" placeholder="记录一下感受吧~"
                value="{{note}}" bindinput="onNoteInput" maxlength="200" />
    </view>

    <view class="btn btn-primary btn-block" style="margin-top: 24rpx;" bindtap="addRecord">
      🩸 添加这条记录
    </view>
  </view>

  <!-- 历史记录 -->
  <view class="history-section">
    <view class="section-title">📜 历史记录</view>
    <view wx:if="{{records.length > 0}}">
      <view class="rec-card" wx:for="{{records}}" wx:key="id">
        <view class="rec-date">
          <text class="rd-day">{{item.dateDay}}</text>
          <text class="rd-ym">{{item.dateYM}}</text>
        </view>
        <view class="rec-body">
          <view class="rec-flags">
            <text class="flow-tag">
              {{item.flowEmoji}} {{item.flowLabel}}
            </text>
            <text class="symp-tag" wx:for="{{item.symptomLabels}}" wx:for-item="sl" wx:key="*this">
              #{{sl}}
            </text>
          </view>
          <view class="rec-note" wx:if="{{item.note}}">{{item.note}}</view>
        </view>
        <view class="rec-del" catchtap="deleteRecord" data-id="{{item.id}}">🗑️</view>
      </view>
    </view>
    <view class="empty-state" style="padding: 60rpx 32rpx;" wx:else>
      <view class="empty-emoji">📭</view>
      <view class="empty-title">暂无历史记录</view>
      <view class="empty-desc">添加第一条经期记录，开启健康预测吧~</view>
    </view>
  </view>
</view>
