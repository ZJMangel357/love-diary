/* pages/period-record/period-record.wxss */
.page {
  min-height: 100vh;
  background: #FFF0F6;
  padding: 32rpx;
  box-sizing: border-box;
}

.add-card {
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(255,107,157,0.12);
  margin-bottom: 32rpx;
}

.ac-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #FF6B9D;
  margin-bottom: 24rpx;
}

.ac-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #FFF5F8;
}

.ac-row.col {
  flex-direction: column;
  align-items: flex-start;
}

.ac-label {
  font-size: 26rpx;
  color: #4A4A4A;
  font-weight: 700;
  margin-right: 24rpx;
  flex-shrink: 0;
  margin-bottom: 14rpx;
}

.ac-row.col .ac-label {
  margin-right: 0;
  margin-bottom: 16rpx;
}

.ac-date {
  font-size: 28rpx;
  color: #FF6B9D;
  font-weight: 700;
  background: rgba(255,107,157,0.1);
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
}

.symp-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  width: 100%;
}

.symp-item {
  background: #FFF5F8;
  border: 2rpx solid #FFE4EF;
  border-radius: 22rpx;
  padding: 14rpx 10rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.symp-item.active {
  background: linear-gradient(135deg, rgba(255,107,157,0.2) 0%, rgba(201,72,158,0.2) 100%);
  border-color: #FF6B9D;
  transform: translateY(-2rpx);
}

.si-emoji {
  display: block;
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.si-label {
  font-size: 22rpx;
  color: #4A4A4A;
  font-weight: 500;
}

.symp-item.active .si-label {
  color: #C9489E;
  font-weight: 700;
}

.flow-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  width: 100%;
}

.flow-item {
  background: #FFF5F8;
  border: 2rpx solid #FFE4EF;
  border-radius: 22rpx;
  padding: 18rpx 8rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.flow-item.active {
  background: linear-gradient(135deg, #FF6B9D 0%, #C9489E 100%);
  border-color: transparent;
  box-shadow: 0 6rpx 18rpx rgba(201,72,158,0.3);
}

.fi-emoji {
  display: block;
  font-size: 30rpx;
  margin-bottom: 6rpx;
  letter-spacing: -4rpx;
}

.fi-label {
  font-size: 22rpx;
  color: #4A4A4A;
  font-weight: 500;
}

.flow-item.active .fi-label {
  color: #FFFFFF;
  font-weight: 700;
}

.form-textarea {
  background: #FFF5F8;
  border: 2rpx solid #FFE4EF;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #4A4A4A;
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #4A4A4A;
  margin-bottom: 20rpx;
}

.rec-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 20rpx;
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(255,107,157,0.08);
}

.rec-date {
  width: 100rpx;
  flex-shrink: 0;
  text-align: center;
  padding: 8rpx;
  background: linear-gradient(135deg, #FFE8F0 0%, #FFF0F6 100%);
  border-radius: 20rpx;
  margin-right: 16rpx;
}

.rd-day {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #FF6B9D 0%, #C9489E 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1.1;
}

.rd-ym {
  font-size: 20rpx;
  color: #8A7F8A;
}

.rec-body {
  flex: 1;
  min-width: 0;
}

.rec-flags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.flow-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  background: rgba(255,107,157,0.12);
  color: #FF6B9D;
  font-weight: 600;
}

.symp-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(155,127,237,0.12);
  color: #9B7FED;
  font-weight: 500;
}

.rec-note {
  font-size: 24rpx;
  color: #6A6A6A;
  line-height: 1.5;
}

.rec-del {
  padding: 8rpx;
  font-size: 32rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}
