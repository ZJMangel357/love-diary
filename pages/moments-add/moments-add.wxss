/* pages/moments-add/moments-add.wxss */
.page {
  min-height: 100vh;
  background: #FFFEF5;
  padding: 32rpx;
  box-sizing: border-box;
}

.form-container {
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 32rpx rgba(255,179,71,0.12);
}

.mood-section {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #FFFAEC;
}

.section-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A4A4A;
  margin-bottom: 16rpx;
}

.section-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sub-hint {
  font-size: 22rpx;
  color: #B8A5A5;
  margin-top: 10rpx;
}

.mood-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.mood-item {
  background: #FFFEF5;
  border: 2rpx solid #FFF2D6;
  border-radius: 24rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.mood-item.active {
  background: linear-gradient(135deg, #FFD93D 0%, #FFB347 100%);
  border-color: transparent;
  box-shadow: 0 6rpx 20rpx rgba(255,179,71,0.35);
  transform: translateY(-2rpx);
}

.mi-emoji {
  display: block;
  font-size: 40rpx;
  margin-bottom: 6rpx;
}

.mi-label {
  display: block;
  font-size: 22rpx;
  color: #4A4A4A;
  font-weight: 500;
}

.mood-item.active .mi-label {
  color: #FFFFFF;
  font-weight: 600;
}

.form-section {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #FFFAEC;
}

.form-section:last-of-type {
  border-bottom: none;
}

.form-input {
  background: #FFFEF5;
  border: 2rpx solid #FFF2D6;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #4A4A4A;
  width: 100%;
  box-sizing: border-box;
}

.form-textarea {
  background: #FFFEF5;
  border: 2rpx solid #FFF2D6;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #4A4A4A;
  width: 100%;
  box-sizing: border-box;
  line-height: 1.7;
  min-height: 200rpx;
}

.count-tip {
  text-align: right;
  font-size: 22rpx;
  color: #B8A5A5;
  margin-top: 8rpx;
}

.mini-picker {
  font-size: 26rpx;
  color: #FFB347;
  font-weight: 700;
  background: rgba(255,179,71,0.1);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
}

.loc-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.loc-input {
  flex: 1;
}

.loc-btn {
  width: 80rpx;
  height: 72rpx;
  background: rgba(255,179,71,0.15);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.img-wrap {
  position: relative;
  aspect-ratio: 1;
  border-radius: 20rpx;
  overflow: hidden;
}

.img-item {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  background: #FFF8E0;
}

.img-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.6);
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.img-add {
  aspect-ratio: 1;
  border: 3rpx dashed #FFD93D;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFFBE8 0%, #FFFEF5 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-plus {
  font-size: 56rpx;
  color: #FFB347;
  line-height: 1;
  font-weight: 300;
}

.add-label {
  font-size: 20rpx;
  color: #B8943D;
  font-weight: 600;
  margin-top: 4rpx;
}

.save-btn {
  padding: 28rpx;
  font-size: 32rpx;
  background: linear-gradient(135deg, #5CC9A5 0%, #FFD93D 100%);
  box-shadow: 0 10rpx 28rpx rgba(92,201,165,0.3);
}
