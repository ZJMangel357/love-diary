<!--pages/profile/profile.wxml-->
<view class="page">
  <!-- 顶部渐变 -->
  <view class="hero-section hero-pink" style="margin: 0; border-radius: 0 0 48rpx 48rpx; padding-bottom: 80rpx;">
    <view class="deco-heart" style="top: 20rpx; right: 50rpx; font-size: 90rpx;">💫</view>
    <view class="deco-heart" style="top: 100rpx; left: 40rpx; font-size: 56rpx; opacity: 0.25;">✨</view>
    <view class="hero-title">💝 我的</view>
    
    <!-- 情侣卡片 -->
    <view class="couple-big-card animate-bounce-in" bindtap="editCouple">
      <view class="cbc-avatars">
        <view class="avatar-wrap-l">
          <view class="avatar avatar-lg">{{coupleInfo.partnerName1[0] || '他'}}</view>
          <view class="small-heart heart-1">💕</view>
        </view>
        <view class="cbc-love">
          <text class="love-since">在一起</text>
          <text class="love-days-big">{{loveDays || '-'}}</text>
          <text class="love-days-unit">天</text>
        </view>
        <view class="avatar-wrap-r">
          <view class="avatar avatar-lg">{{coupleInfo.partnerName2[0] || '她'}}</view>
          <view class="small-heart heart-2">💖</view>
        </view>
      </view>
      <view class="cbc-names">
        <text class="cbc-name him">{{coupleInfo.partnerName1 || '他'}}</text>
        <text class="cbc-and">&</text>
        <text class="cbc-name her">{{coupleInfo.partnerName2 || '她'}}</text>
      </view>
      <view class="cbc-edit-tip">点击编辑昵称 ✏️</view>
    </view>
  </view>

  <view class="container container-padding-bottom" style="margin-top: -60rpx;">
    <!-- 数据统计 -->
    <view class="stats-card animate-slide-up" bindtap="showStats">
      <view class="sc-title">📊 我们的记录</view>
      <view class="sc-grid">
        <view class="sc-item">
          <text class="sc-num">{{dataStats.menus}}</text>
          <text class="sc-label">菜品</text>
        </view>
        <view class="sc-item">
          <text class="sc-num">{{dataStats.anniversaries}}</text>
          <text class="sc-label">纪念日</text>
        </view>
        <view class="sc-item">
          <text class="sc-num">{{dataStats.moments}}</text>
          <text class="sc-label">时光</text>
        </view>
        <view class="sc-item">
          <text class="sc-num">{{dataStats.periods}}</text>
          <text class="sc-label">记录</text>
        </view>
      </view>
    </view>

    <!-- 主题选择 -->
    <view class="section-title">🎨 主题风格</view>
    <view class="theme-grid">
      <view class="theme-card animate-slide-up {{currentTheme === index ? 'active' : ''}}"
            wx:for="{{themeOptions}}" wx:key="name"
            style="animation-delay: {{index * 0.08}}s;"
            data-idx="{{index}}" bindtap="switchTheme">
        <view class="theme-preview">
          <view class="tp-colors">
            <view class="tp-dot" style="background: {{item.primary}};"></view>
            <view class="tp-dot" style="background: {{item.secondary}};"></view>
            <view class="tp-dot" style="background: {{item.accent}};"></view>
          </view>
          <view class="tp-emoji">{{item.emoji}}</view>
        </view>
        <text class="theme-name">{{item.name}}</text>
        <view class="theme-check" wx:if="{{currentTheme === index}}">✓</view>
      </view>
    </view>

    <!-- 设置菜单 -->
    <view class="section-title">⚙️ 设置 & 功能</view>
    <view class="settings-list">
      <view class="setting-item" bindtap="setLoveDate">
        <view class="si-icon list-icon-pink">📅</view>
        <view class="si-content">
          <text class="si-title">恋爱纪念日</text>
          <text class="si-subtitle">{{coupleInfo.loveDate || '点击设置'}}</text>
        </view>
        <text class="si-arrow">›</text>
      </view>
      
      <view class="setting-item" bindtap="exportData">
        <view class="si-icon list-icon-mint">📤</view>
        <view class="si-content">
          <text class="si-title">导出数据备份</text>
          <text class="si-subtitle">复制所有数据到剪贴板保存</text>
        </view>
        <text class="si-arrow">›</text>
      </view>
      
      <view class="setting-item" bindtap="importData">
        <view class="si-icon list-icon-yellow">📥</view>
        <view class="si-content">
          <text class="si-title">导入备份数据</text>
          <text class="si-subtitle">从剪贴板恢复之前的数据</text>
        </view>
        <text class="si-arrow">›</text>
      </view>

      <view class="setting-item" open-type="share">
        <view class="si-icon list-icon-purple">📤</view>
        <view class="si-content">
          <text class="si-title">分享给恋人</text>
          <text class="si-subtitle">把甜蜜日记分享给TA</text>
        </view>
        <text class="si-arrow">›</text>
      </view>
      
      <view class="setting-item" bindtap="showAbout">
        <view class="si-icon list-icon-orange">ℹ️</view>
        <view class="si-content">
          <text class="si-title">关于甜蜜日记</text>
          <text class="si-subtitle">v1.0.0</text>
        </view>
        <text class="si-arrow">›</text>
      </view>
      
      <view class="setting-item danger" bindtap="resetAll">
        <view class="si-icon" style="background: rgba(255,107,157,0.15);">🗑️</view>
        <view class="si-content">
          <text class="si-title" style="color: #FF6B9D;">重置所有数据</text>
          <text class="si-subtitle">清除全部内容，恢复默认示例</text>
        </view>
        <text class="si-arrow">›</text>
      </view>
    </view>

    <!-- 底部签名 -->
    <view class="footer-sign">
      <text>💕 用爱记录每一天 💕</text>
    </view>
  </view>
</view>
