<!--pages/menu/menu.wxml-->
<view class="page">
  <!-- 顶部渐变装饰 -->
  <view class="hero-section hero-mint" style="margin: 0; border-radius: 0 0 48rpx 48rpx;">
    <view class="deco-heart" style="top: 20rpx; right: 60rpx; font-size: 80rpx;">🥗</view>
    <view class="deco-heart" style="top: 80rpx; left: 40rpx; font-size: 50rpx; opacity: 0.25;">🍴</view>
    <view class="hero-title">🍳 爱的菜单</view>
    <view class="hero-subtitle">今天也要好好吃饭哦~</view>
    
    <!-- 搜索框 -->
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索菜名或标签..." value="{{searchKeyword}}" bindinput="onSearch" confirm-type="search" />
    </view>
    
    <!-- 今日菜单 -->
    <view class="today-menu-mini" wx:if="{{todayMenu}}" bindtap="setAsToday" data-id="{{todayMenu.id}}">
      <view class="tm-label">🎯 今日菜单</view>
      <view class="tm-name">{{todayMenu.name}}</view>
      <view class="tm-change">换一个</view>
    </view>
  </view>

  <view class="container container-padding-bottom">
    <!-- 分类导航 -->
    <scroll-view scroll-x="true" class="cat-scroll" show-scrollbar="{{false}}">
      <view class="cat-item {{activeCategory === item ? 'active' : ''}}" 
            wx:for="{{categories}}" wx:key="*this"
            data-category="{{item}}" bindtap="switchCategory">
        {{item}}
      </view>
    </scroll-view>

    <!-- 工具栏 -->
    <view class="tool-bar">
      <view class="sort-group">
        <view class="sort-item {{sortBy === 'default' ? 'active' : ''}}" data-sort="default" bindtap="changeSort">默认</view>
        <view class="sort-item {{sortBy === 'favorite' ? 'active' : ''}}" data-sort="favorite" bindtap="changeSort">💖 收藏</view>
        <view class="sort-item {{sortBy === 'difficulty' ? 'active' : ''}}" data-sort="difficulty" bindtap="changeSort">⭐ 简单</view>
      </view>
      <view class="random-btn" bindtap="openRandom">
        <text class="rb-icon">🎲</text>
        <text class="rb-text">随机</text>
      </view>
    </view>

    <!-- 菜品列表 -->
    <view class="menu-list" wx:if="{{filteredMenus.length > 0}}">
      <view class="dish-card animate-slide-up" wx:for="{{filteredMenus}}" wx:key="id"
            style="animation-delay: {{index % 6 * 0.05}}s;">
        <view class="dish-visual">
          <view class="dish-emoji-wrap">
            <text class="dish-emoji">🍽️</text>
          </view>
          <view class="dish-difficulty">{{item.difficultyStars}}</view>
        </view>
        
        <view class="dish-body">
          <view class="dish-head">
            <text class="dish-name">{{item.name}}</text>
            <view class="fav-btn {{item.favorite ? 'faved' : ''}}" catchtap="toggleFavorite" data-id="{{item.id}}">
              {{item.favorite ? '💖' : '🤍'}}
            </view>
          </view>
          
          <view class="dish-cat">{{item.category}}</view>
          
          <view class="dish-tags" wx:if="{{item.tags && item.tags.length > 0}}">
            <text class="tag tag-pink" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
          </view>
          
          <view class="dish-actions">
            <view class="action-btn set-today" catchtap="setAsToday" data-id="{{item.id}}">
              <text>🍽️ 今日就它</text>
            </view>
            <view class="action-btn delete-btn" catchtap="deleteMenu" data-id="{{item.id}}">
              <text>🗑️ 删除</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <view class="empty-emoji animate-float">🍜</view>
      <view class="empty-title">还没有添加菜品</view>
      <view class="empty-desc">点击右下角按钮，添加第一道菜吧~</view>
    </view>
  </view>

  <!-- 随机选菜弹窗 -->
  <view class="random-modal" wx:if="{{showRandomModal}}">
    <view class="random-mask" bindtap="closeRandom"></view>
    <view class="random-content animate-bounce-in">
      <view class="random-title">🎲 今天吃什么？</view>
      <view class="random-spinner">
        <view class="dish-preview" wx:if="{{randomResult}}">
          <view class="preview-emoji animate-pulse">🍳</view>
          <view class="preview-name">{{randomResult.name}}</view>
          <view class="preview-cat">{{randomResult.category}}</view>
        </view>
        <view class="preview-emoji" wx:else>
          <text class="spin-emoji animate-float">🍳🥗🍜🍱🥘🍲</text>
        </view>
      </view>
      <view class="random-btns">
        <view class="btn btn-outline btn-flex" bindtap="closeRandom">再想想</view>
        <view class="btn btn-primary btn-flex" bindtap="confirmRandom">就它了！</view>
      </view>
    </view>
  </view>

  <!-- 浮动添加按钮 -->
  <view class="fab" bindtap="goAdd" style="background: linear-gradient(135deg, #5CC9A5 0%, #A8E6CF 100%);">
    <text>+</text>
  </view>
</view>
