/* app.wxss - 恋爱糖系风全局样式 */

page {
  --primary: #FF6B9D;
  --primary-light: #FFB4CC;
  --primary-dark: #E55A8B;
  --secondary: #A8E6CF;
  --secondary-light: #D4F5E6;
  --accent: #FFD93D;
  --accent-light: #FFF0B3;
  --purple: #C9B1FF;
  --orange: #FFB380;
  --bg: #FFF5F8;
  --bg-gradient: linear-gradient(135deg, #FFF5F8 0%, #F0FFF9 50%, #FFFEF0 100%);
  --card-bg: #FFFFFF;
  --text-primary: #4A4A4A;
  --text-secondary: #8A7F8A;
  --text-hint: #B8A5A5;
  --border: #FFE4EF;
  --shadow-soft: 0 8rpx 32rpx rgba(255, 107, 157, 0.12);
  --shadow-medium: 0 16rpx 48rpx rgba(255, 107, 157, 0.18);
  --shadow-float: 0 24rpx 64rpx rgba(255, 107, 157, 0.22);
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 36rpx;
  --radius-xl: 48rpx;
  background: var(--bg-gradient);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.container-padding-bottom {
  padding-bottom: 180rpx;
}

/* 卡片样式 */
.card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-soft);
  margin-bottom: 28rpx;
  position: relative;
  overflow: hidden;
}

.card-candy {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFBFD 100%);
  border: 2rpx solid var(--border);
}

.card-gradient-pink {
  background: linear-gradient(135deg, #FFE8F0 0%, #FFF5F8 100%);
}

.card-gradient-mint {
  background: linear-gradient(135deg, #E8F8F0 0%, #F5FFFA 100%);
}

.card-gradient-yellow {
  background: linear-gradient(135deg, #FFF8E0 0%, #FFFEF5 100%);
}

/* 按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-xl);
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  border: none;
  padding: 24rpx 48rpx;
  box-sizing: border-box;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8FB3 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.35);
}

.btn-primary:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.25);
}

.btn-secondary {
  background: linear-gradient(135deg, #A8E6CF 0%, #C2EFD9 100%);
  color: #2D8B65;
  box-shadow: 0 8rpx 24rpx rgba(168, 230, 207, 0.35);
}

.btn-accent {
  background: linear-gradient(135deg, #FFD93D 0%, #FFE680 100%);
  color: #8B6914;
  box-shadow: 0 8rpx 24rpx rgba(255, 217, 61, 0.35);
}

.btn-outline {
  background: transparent;
  border: 3rpx solid var(--primary);
  color: var(--primary);
}

.btn-ghost {
  background: rgba(255, 107, 157, 0.1);
  color: var(--primary);
}

.btn-block {
  width: 100%;
}

.btn-small {
  padding: 14rpx 28rpx;
  font-size: 24rpx;
  border-radius: var(--radius-md);
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-xl);
  font-size: 22rpx;
  font-weight: 500;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-pink {
  background: rgba(255, 107, 157, 0.15);
  color: var(--primary);
}

.tag-mint {
  background: rgba(168, 230, 207, 0.4);
  color: #2D8B65;
}

.tag-yellow {
  background: rgba(255, 217, 61, 0.3);
  color: #8B6914;
}

.tag-purple {
  background: rgba(201, 177, 255, 0.35);
  color: #7B5FCC;
}

.tag-orange {
  background: rgba(255, 179, 128, 0.35);
  color: #CC7A3D;
}

/* 标题样式 */
.title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.title-candy {
  font-size: 44rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6B9D 0%, #C9B1FF 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin: 32rpx 0 20rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #FF6B9D 0%, #FFD93D 100%);
  border-radius: 8rpx;
  margin-right: 16rpx;
}

/* 文本样式 */
.text-primary { color: var(--primary); }
.text-mint { color: #2D8B65; }
.text-accent { color: #8B6914; }
.text-secondary { color: var(--text-secondary); }
.text-hint { color: var(--text-hint); }

.text-bold { font-weight: 700; }
.text-light { font-weight: 300; }

.text-lg { font-size: 36rpx; }
.text-xl { font-size: 44rpx; }
.text-xxl { font-size: 56rpx; }
.text-sm { font-size: 24rpx; }
.text-xs { font-size: 22rpx; }

/* Flex 布局工具 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-row { flex-direction: row; }
.flex-wrap { flex-wrap: wrap; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.items-end { align-items: flex-end; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-around { justify-content: space-around; }
.justify-end { justify-content: flex-end; }
.flex-1 { flex: 1; }
.flex-shrink-0 { flex-shrink: 0; }

/* 间距工具 */
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mt-48 { margin-top: 48rpx; }

.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
.mb-48 { margin-bottom: 48rpx; }

.ml-8 { margin-left: 8rpx; }
.ml-16 { margin-left: 16rpx; }
.ml-24 { margin-left: 24rpx; }

.mr-8 { margin-right: 8rpx; }
.mr-16 { margin-right: 16rpx; }
.mr-24 { margin-right: 24rpx; }

.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }

.px-16 { padding-left: 16rpx; padding-right: 16rpx; }
.px-24 { padding-left: 24rpx; padding-right: 24rpx; }
.px-32 { padding-left: 32rpx; padding-right: 32rpx; }

.py-16 { padding-top: 16rpx; padding-bottom: 16rpx; }
.py-24 { padding-top: 24rpx; padding-bottom: 24rpx; }

/* 分割线 */
.divider {
  height: 2rpx;
  background: var(--border);
  margin: 24rpx 0;
}

.divider-dashed {
  border-top: 2rpx dashed var(--border);
  background: none;
}

/* 空状态 */
.empty-state {
  padding: 80rpx 32rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  animation: float 3s ease-in-out infinite;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-hint);
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8FB3 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  box-shadow: 0 16rpx 40rpx rgba(255, 107, 157, 0.45);
  z-index: 100;
  transition: all 0.3s ease;
}

.fab:active {
  transform: scale(0.92);
}

/* 输入框样式 */
.input-group {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid var(--border);
}

.input-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
  margin-bottom: 8rpx;
  margin-top: 16rpx;
}

.input {
  width: 100%;
  height: 72rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  padding: 16rpx 0;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 动画 */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

@keyframes bounce-in {
  0% { opacity: 0; transform: scale(0.3); }
  50% { transform: scale(1.08); }
  70% { transform: scale(0.95); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes slide-up {
  0% { opacity: 0; transform: translateY(40rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes fade-in {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.animate-float { animation: float 3s ease-in-out infinite; }
.animate-pulse { animation: pulse 2s ease-in-out infinite; }
.animate-bounce-in { animation: bounce-in 0.6s ease-out; }
.animate-slide-up { animation: slide-up 0.5s ease-out; }
.animate-fade-in { animation: fade-in 0.4s ease-out; }

/* 装饰元素 */
.deco-heart {
  position: absolute;
  opacity: 0.15;
  font-size: 100rpx;
  pointer-events: none;
}

.deco-dot {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  opacity: 0.12;
  pointer-events: none;
}

.deco-dot-pink { background: radial-gradient(circle, #FF6B9D 0%, transparent 70%); }
.deco-dot-mint { background: radial-gradient(circle, #A8E6CF 0%, transparent 70%); }
.deco-dot-yellow { background: radial-gradient(circle, #FFD93D 0%, transparent 70%); }

/* 头像样式 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFB4CC 0%, #C9B1FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
  overflow: hidden;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.2);
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
  font-size: 48rpx;
  border-width: 6rpx;
}

.avatar-xl {
  width: 160rpx;
  height: 160rpx;
  font-size: 64rpx;
  border-width: 8rpx;
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.06);
  transition: all 0.2s ease;
}

.list-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 157, 0.08);
}

.list-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.list-icon-pink { background: rgba(255, 107, 157, 0.15); }
.list-icon-mint { background: rgba(168, 230, 207, 0.35); }
.list-icon-yellow { background: rgba(255, 217, 61, 0.3); }
.list-icon-purple { background: rgba(201, 177, 255, 0.3); }
.list-icon-orange { background: rgba(255, 179, 128, 0.3); }

.list-arrow {
  font-size: 32rpx;
  color: var(--text-hint);
  flex-shrink: 0;
}

/* 进度条 */
.progress-bar {
  height: 16rpx;
  background: var(--border);
  border-radius: var(--radius-xl);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: var(--radius-xl);
  background: linear-gradient(90deg, #FF6B9D 0%, #FFD93D 100%);
  transition: width 0.6s ease;
}

/* 徽章 */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: var(--primary);
}

/* 顶部渐变标题区域 */
.hero-section {
  position: relative;
  padding: 48rpx 32rpx 64rpx;
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
  margin: -32rpx -32rpx 32rpx;
  overflow: hidden;
}

.hero-pink {
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB4CC 50%, #FFD93D 100%);
}

.hero-mint {
  background: linear-gradient(135deg, #5CC9A5 0%, #A8E6CF 50%, #C9B1FF 100%);
}

.hero-purple {
  background: linear-gradient(135deg, #9B7FED 0%, #C9B1FF 50%, #FFB4CC 100%);
}

.hero-yellow {
  background: linear-gradient(135deg, #FFB347 0%, #FFD93D 50%, #A8E6CF 100%);
}

.hero-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #FFFFFF;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.hero-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
}

/* 悬浮胶囊导航（用于页面内） */
.pill-nav {
  display: flex;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  border-radius: var(--radius-xl);
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-soft);
}

.pill-nav-item {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  border-radius: var(--radius-xl);
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  transition: all 0.3s ease;
}

.pill-nav-item.active {
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8FB3 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.3);
}
